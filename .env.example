PG_USER=agent
PG_PASSWORD=agent
PG_DATABASE=agent_backend
PG_HOST=127.0.0.1
PG_PORT=5432
DATABASE_URL=postgresql+asyncpg://agent:agent@127.0.0.1:5432/agent_backend
TABLE_PREFIX=agent_
AGENT_BACKEND=echo
MODEL=qwen-plus
AGENT_MODEL=qwen-plus
# Root directory DeepAgents may read to discover local skills. Keep `skills/`
# below this directory when copying shared skills to another agent project.
# AGENT_FILESYSTEM_ROOT=/path/to/deepagent_interface
# Comma-separated skill roots relative to AGENT_FILESYSTEM_ROOT.
AGENT_SKILLS_PATHS=skills
# Enterprise policy MCP; token may be read from the existing KB .env (only MCP_AUTH_TOKEN).
POLICY_MCP_URL=http://10.1.80.12:9020/mcp
# POLICY_MCP_TOKEN=
POLICY_MCP_ENV_FILE=/opt/Workspace/CRX/enterprice_policy_kb/.env
MAX_TOOL_CALLS=10
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
PUBLIC_BASE_URL=http://127.0.0.1:8000
BOCHA_API_KEY=
BOCHA_API_URL=https://api.bocha.cn/v1/ai-search
MODEL_GUARD_ENABLED=true
MODEL_GUARD_RESPONSE=
