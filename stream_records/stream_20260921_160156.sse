event: tool.call.completed
data: {"run_id":"run_68eacf93cb274dd29dbf2d2cc04deb84","tool_call_id":"call_e31998603e624da59e473058","tool_type":"search_enterprise_policy","result":{"query":"请假扣钱 工资 扣款","result_count":5,"results":[{"id":"副本公司规章制度汇编.pdf:0036","score":0.016393441706895828,"file_id":"副本公司规章制度汇编.pdf","chunk_id":"0036","source_pages":[7],"source_article":"第三十六条（发薪日）","title":"第三十六条（发薪日）","content":"工资以货币形式按月支付，于每月【10】日发放上月工资（遇节假日提前至最近工作日），并由公司代扣代缴个人所得税及社保、公积金个人承担部分。公司不无故克扣、拖欠工资。"},{"id":"副本公司规章制度汇编.pdf:0055","score":0.016129031777381897,"file_id":"副本公司规章制度汇编.pdf","chunk_id":"0055","source_pages":[10],"source_article":"第五十五条（离职结算）","title":"第五十五条（离职结算）","content":"工资结算至最后工作日，于离职手续办结后正常发薪日或依法约定期限内支付；符合条件的支付经济补偿。年休假未休部分按 300% 标准折算（其中 100% 已含在正常工资中）。"},{"id":"副本公司规章制度汇编.pdf:0022","score":0.01587301678955555,"file_id":"副本公司规章制度汇编.pdf","chunk_id":"0022","source_pages":[5],"source_article":"第二十二条（迟到、早退与旷工）","title":"第二十二条（迟到、早退与旷工）","content":"超过规定上班时间到岗的为迟到；提前离岗的为早退。迟到或早退 30 分钟以内的，每次扣款【20】元；月累计 3 次以上加倍扣款。有下列情形之一的认定为旷工：（一）未办理请假手续或请假未获批准而缺勤；（二）假期届满未续假且未到岗；（三）不服从工作调动、安排，拒不到岗；（四）提供虚假请假事由。旷工一天扣除当日工资的 300%（以全额工资折算），月累计旷工 3 天或年累计旷工 5 天以上的，属严重违反劳动纪律，公司有权解除劳动合同。"},{"id":"副本公司规章制度汇编.pdf:0027","score":0.015625,"file_id":"副本公司规章制度汇编.pdf","chunk_id":"0027","source_pages":[6],"source_article":"第二十七条（带薪年休假）","title":"第二十七条（带薪年休假）","content":"员工累计工作满 1 年不满 10 年的，年休假 5 天；满 10 年不满 20 年的，年休假 10 天；满 20 年的，年休假 15 天。年休假原则上当年使用，经批准可跨 1 个年度安排。员工有《职工带薪年休假条例》第四条所列情形（如请事假累计 20 天以上且单位不扣工资等）的，不享受当年年休假。公司统筹安排员工休年休假，因工作原因未休的，按日工资收入的 300% 支付未休年休假工资报酬（含正常工作期间工资）。"},{"id":"副本公司规章制度汇编.pdf:0023","score":0.015384615398943424,"file_id":"副本公司规章制度汇编.pdf","chunk_id":"0023","source_pages":[5],"source_article":"第二十三条（加班管理）","title":"第二十三条（加班管理）","content":"加班须事前填写《加班申请单》并经部门负责人批准，未经批准的不计加班。公司安排加班的，按下列标准支付加班费或安排补休：（一）工作日加班：支付不低于工资 150% 的加班费；（二）休息日加班：优先安排补休，无法补休的支付不低于 200% 的加班费；（三）法定节假日加班：支付不低于 300% 的加班费，不得以补休替代。补休须在 6 个月内使用完毕。"}]}}

