event: tool.call.completed
data: {"run_id":"run_68eacf93cb274dd29dbf2d2cc04deb84","tool_call_id":"call_ede37680e65046e8b068af39","tool_type":"search_enterprise_policy","result":{"query":"婚假 产假 丧假 带薪 假期天数","result_count":5,"results":[{"id":"副本公司规章制度汇编.pdf:0030","score":0.032522473484277725,"source_pages":[6],"source_article":"第三十条（婚假）","title":"第三十条（婚假）","content":"员工依法登记结婚的，享受婚假。国家规定婚假为 3 天，另按当地人口与计划生育条例享受奖励婚假（各地标准不同，按公司所在地规定执行，如多数省份为 10 至 18 天）。婚假须在登记后【1】年内一次性休完。","file_id":"副本公司规章制度汇编.pdf","chunk_id":"0030"},{"id":"副本公司规章制度汇编.pdf:0032","score":0.032522473484277725,"source_pages":[7],"source_article":"第三十二条（丧假）","title":"第三十二条（丧假）","content":"员工直系亲属（父母、配偶、子女）死亡的，丧假 3 天；岳父母、公婆死亡的，丧假【1—3 天】。异地奔丧的可另给路途假。","file_id":"副本公司规章制度汇编.pdf","chunk_id":"0032"},{"id":"副本公司规章制度汇编.pdf:0027","score":0.01587301678955555,"source_pages":[6],"source_article":"第二十七条（带薪年休假）","title":"第二十七条（带薪年休假）","content":"员工累计工作满 1 年不满 10 年的，年休假 5 天；满 10 年不满 20 年的，年休假 10 天；满 20 年的，年休假 15 天。年休假原则上当年使用，经批准可跨 1 个年度安排。员工有《职工带薪年休假条例》第四条所列情形（如请事假累计 20 天以上且单位不扣工资等）的，不享受当年年休假。公司统筹安排员工休年休假，因工作原因未休的，按日工资收入的 300% 支付未休年休假工资报酬（含正常工作期间工资）。","file_id":"副本公司规章制度汇编.pdf","chunk_id":"0027"},{"id":"副本公司规章制度汇编.pdf:0031","score":0.015625,"source_pages":[6],"source_article":"第三十一条（产假与生育相关假期）","title":"第三十一条（产假与生育相关假期）","content":"女员工生育享受 98 天产假（产前可休 15 天），难产增加 15 天，多胞胎每多生育 1 个婴儿增加 15 天；另按当地条例享受延长产假（各地一般再增加 60 至 90 天）。怀孕未满 4 个月流产的，享受 15 天产假；满 4 个月流产的，享受 42 天产假。男员工享受陪产假【按当地规定，一般为 15 至 30 天】。女员工在孕期、产期、哺乳期的，公司不得依《劳动合同法》第四十条、四十一条解除合同。婴儿一周岁以内，女员工每天享受 1 小时哺乳时间。","file_id":"副本公司规章制度汇编.pdf","chunk_id":"0031"},{"id":"副本公司规章制度汇编.pdf:0029","score":0.015384615398943424,"source_pages":[6],"source_article":"第二十九条（事假）","title":"第二十九条（事假）","content":"员工因私事需请假的可申请事假，事假期间不发放工资。事假 1 天以内由部门负责人批准，3 天以内由部门分管领导批准，3 天以上由总经理批准。事假原则上全年不超过【15】天。","file_id":"副本公司规章制度汇编.pdf","chunk_id":"0029"}]}}

