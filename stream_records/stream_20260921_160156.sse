event: tool.call.completed
data: {"run_id":"run_68eacf93cb274dd29dbf2d2cc04deb84","tool_call_id":"call_490fdd1a41184d6e80157a90","tool_type":"search_enterprise_policy","result":{"query":"请假 事假 病假 年假 工资发放","result_count":5,"results":[{"id":"副本公司规章制度汇编.pdf:0028","score":0.032522473484277725,"file_id":"副本公司规章制度汇编.pdf","chunk_id":"0028","source_pages":[6],"source_article":"第二十八条（病假）","title":"第二十八条（病假）","content":"员工患病需休假的，应提供二级及以上医院出具的诊断证明、病历及病假建议书。病假期间工资按不低于当地最低工资标准的 80% 支付（公司另有更优规定的从其规定）。医疗期按国家规定执行：实际工作年限 10 年以下的，在本单位工作 5 年以下为 3 个月、5 年以上为 6 个月；10 年以上的，在本单位工作 5 年以下为 6 个月、5 年以上 10 年以下为 9 个月、10 年以上 15 年以下为 12 个月、15 年以上 20 年以下为 18 个月、20 年以上为 24 个月。医疗期满不能从事原工作也不能从事另行安排工作的，公司可依法解除劳动合同并支付经济补偿及医疗补助费。"},{"id":"副本公司规章制度汇编.pdf:0029","score":0.032522473484277725,"file_id":"副本公司规章制度汇编.pdf","chunk_id":"0029","source_pages":[6],"source_article":"第二十九条（事假）","title":"第二十九条（事假）","content":"员工因私事需请假的可申请事假，事假期间不发放工资。事假 1 天以内由部门负责人批准，3 天以内由部门分管领导批准，3 天以上由总经理批准。事假原则上全年不超过【15】天。"},{"id":"副本公司规章制度汇编.pdf:0027","score":0.01587301678955555,"file_id":"副本公司规章制度汇编.pdf","chunk_id":"0027","source_pages":[6],"source_article":"第二十七条（带薪年休假）","title":"第二十七条（带薪年休假）","content":"员工累计工作满 1 年不满 10 年的，年休假 5 天；满 10 年不满 20 年的，年休假 10 天；满 20 年的，年休假 15 天。年休假原则上当年使用，经批准可跨 1 个年度安排。员工有《职工带薪年休假条例》第四条所列情形（如请事假累计 20 天以上且单位不扣工资等）的，不享受当年年休假。公司统筹安排员工休年休假，因工作原因未休的，按日工资收入的 300% 支付未休年休假工资报酬（含正常工作期间工资）。"},{"id":"副本公司规章制度汇编.pdf:0033","score":0.015625,"file_id":"副本公司规章制度汇编.pdf","chunk_id":"0033","source_pages":[7],"source_article":"第三十三条（工伤假）","title":"第三十三条（工伤假）","content":"员工发生工伤的，经工伤认定后停止工作接受治疗，停工留薪期内原工资福利待遇不变，按《工伤保险条例》执行。"},{"id":"副本公司规章制度汇编.pdf:0034","score":0.015384615398943424,"file_id":"副本公司规章制度汇编.pdf","chunk_id":"0034","source_pages":[7],"source_article":"第三十四条（请假流程）","title":"第三十四条（请假流程）","content":"请假一律提前通过 OA/纸质《请假单》申请，3 天以上须提前 3 个工作日申请。请假获批后方可离岗，紧急情况可先电话/线上向部门负责人报备，返岗后 1 个工作日内补办手续。假期期间保持通讯畅通。未经批准擅自休假的按旷工处理。"}]}}

